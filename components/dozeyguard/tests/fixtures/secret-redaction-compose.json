{
  "services": {
    "secretful": {
      "image": "ghcr.io/example/app:1.0",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": ["ALL"],
      "security_opt": ["no-new-privileges:true"],
      "pids_limit": 64,
      "mem_limit": "128m",
      "cpus": "0.25",
      "restart": "unless-stopped",
      "environment": {
        "PRIVATE_KEY": "SECRET_DO_NOT_PRINT_123"
      },
      "healthcheck": {"test": ["CMD", "true"]},
      "logging": {
        "driver": "json-file",
        "options": {"max-size": "10m", "max-file": "3"}
      }
    }
  }
}

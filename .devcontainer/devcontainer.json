{
  "name": "DockerPilot Demo",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "DockerPilot Demo",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash demo/bootstrap.sh",
  "postStartCommand": "bash demo/start.sh",
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "remoteUser": "vscode"
}

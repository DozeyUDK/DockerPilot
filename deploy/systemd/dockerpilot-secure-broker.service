[Unit]
Description=DockerPilot Secure Deploy Broker (verify/dry-run + closed canary)
Documentation=file:///usr/libexec/dockerpilot-secure-broker/docs/ROOT_BROKER_SYSTEMD_HARDENING.md
Requires=dockerpilot-secure-broker.socket
After=network.target dockerpilot-secure-broker.socket

[Service]
Type=simple
User=root
Group=root
UMask=0077
WorkingDirectory=/
ExecStart=/usr/libexec/dockerpilot-secure-broker/broker --config /etc/dockerpilot-secure-broker/config.json
Restart=on-failure
RestartSec=2

# Environment — no EnvironmentFile from user-writable paths
Environment=PYTHONNOUSERSITE=1
Environment=DOCKERPILOT_BROKER_STRICT_ENV=1
Environment=PATH=/usr/bin:/bin
Environment=HOME=/
Environment=LANG=C.UTF-8

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
# MemoryDenyWriteExecute may break some Python runtimes; keep enabled and document if host fails.
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
CapabilityBoundingSet=
AmbientCapabilities=
# Canary needs AF_UNIX (broker + docker.sock) and AF_INET (127.0.0.1 bind check + HTTP health).
# AF_INET6 is intentionally omitted: canary code uses host 127.0.0.1 only (no ::1).
# PrivateNetwork must remain unset/false so the broker shares the host netns and can
# reach the canary published on host loopback 127.0.0.1:18080. PrivateNetwork=true
# would isolate the unit and break port_is_free() + the final HTTP health gate.
RestrictAddressFamilies=AF_UNIX AF_INET
# IP filters apply to IP packets only — they do NOT gate Unix sockets (broker.sock / docker.sock).
IPAddressDeny=any
# Narrowest host IP allow for canary HTTP GET / loopback preflight (port is not filterable here).
IPAddressAllow=127.0.0.1/32
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @reboot @swap @raw-io @debug @module

# docker.sock is intentionally reachable: canary deploy/remove is broker-owned via
# `docker compose` over the Unix socket. Extras must never receive this access.
# Do NOT list /var/run/docker.sock or /run/docker.sock under InaccessiblePaths.
ReadWritePaths=/var/lib/dockerpilot-secure-broker /run/dockerpilot-secure-broker
ReadOnlyPaths=/usr/libexec/dockerpilot-secure-broker /etc/dockerpilot-secure-broker

# Firewall/secret materialization remain disabled. Canary is the only live Docker path.

[Install]
WantedBy=multi-user.target

[Unit]
Description=DockerPilot Secure Deploy Broker (root dry-run/verify; no apply in #11D.1)
Documentation=file:///opt/dockerpilot/docs/security/SECURE_DEPLOY_BROKER_PROTOCOL_V1.md
After=network.target

[Service]
Type=simple
User=root
Group=root
# Socket mode 0660 root:dockerpilot-broker — Extras joins that group only.
ExecStart=/usr/local/sbin/dockerpilot-secure-broker --socket /run/dockerpilot/secure-broker.sock
Environment=BROKER_DOZEYGUARD_BIN=/usr/local/lib/dockerpilot/dozeyguard
Environment=BROKER_DOZEYGUARD_POLICY_PATH=/etc/dockerpilot/dozeyguard-policy.toml
Environment=BROKER_DOZEYGUARD_POLICY_SHA256=REPLACE_WITH_POLICY_SHA256
Restart=on-failure
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
# No TCP listeners. No Flask. No legacy DockerPilotExtras imports.
# No docker.sock. No UFW/iptables. Apply operations disabled until #11D.2+.
ReadOnlyPaths=/usr/local/lib/dockerpilot /etc/dockerpilot
ReadWritePaths=/run/dockerpilot

[Install]
WantedBy=multi-user.target

[Unit]
Description=DockerPilot Secure Deploy Broker (preview-only / dry-run verify; NO canary)
Documentation=file:///opt/dockerpilot/docs/security/SECURE_DEPLOY_BROKER_PROTOCOL_V1.md
After=network.target

[Service]
Type=simple
User=root
Group=root
# Socket mode 0660 root:dockerpilot-broker — Extras joins that group only.
ExecStart=/usr/local/sbin/dockerpilot-secure-broker --socket /run/dockerpilot-secure-broker/broker.sock
Environment=BROKER_DOZEYGUARD_BIN=/usr/local/lib/dockerpilot/dozeyguard
Environment=BROKER_DOZEYGUARD_POLICY_PATH=/etc/dockerpilot/dozeyguard-policy.toml
Environment=BROKER_DOZEYGUARD_POLICY_SHA256=REPLACE_WITH_POLICY_SHA256
Restart=on-failure
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
# Preview-only: AF_UNIX only. No AF_INET / no loopback / no docker.sock.
# Production canary unit is deploy/systemd/dockerpilot-secure-broker.service.
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
# No TCP listeners. No Flask. No legacy DockerPilotExtras imports.
# No docker.sock. No UFW/iptables. Canary/apply disabled in this example.
InaccessiblePaths=/var/run/docker.sock
InaccessiblePaths=-/run/docker.sock
ReadOnlyPaths=/usr/local/lib/dockerpilot /etc/dockerpilot
ReadWritePaths=/run/dockerpilot

[Install]
WantedBy=multi-user.target
